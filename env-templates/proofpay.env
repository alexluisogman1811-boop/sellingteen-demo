# sellingteen settings for proofpay. Created on the server by `manage.py setup`. PRIVATE: never post this file online.
SUPPORT_EMAIL=sellerteen096@gmail.com
LEGAL_NAME=sellingteen
BILLING_ENABLED=1
TRIAL_DAYS=30
# Paste this app's payment page link after a parent sets up payments, then Reload the web app:
PAYMENT_LINK=

PRICE_TEXT=$12 per month
APP_ENV=production
AI_MOCK=1
DEMO_MODE=0
SESSION_COOKIE_SECURE=1
DATABASE_URL=sqlite:///{DATA}/proofpay.db
UPLOAD_FOLDER={DATA}/uploads
APP_BASE_URL={BASE}/proofpay
SECRET_KEY=__GENERATE__
