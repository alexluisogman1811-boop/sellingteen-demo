# sellingteen site settings. PRIVATE: never post this file online. After changing it, Reload the web app.
# Your web app address on PythonAnywhere (change YOURNAME):
BASE_URL=https://YOURNAME.pythonanywhere.com

# Owner Control Center at /admin. Stays OFF until you run:  python3.13 manage.py set-admin-password
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Automatic activation after payment. Each stays OFF until its secret is pasted here.
# Stripe: Developers > Webhooks > add endpoint https://YOURNAME.pythonanywhere.com/webhooks/stripe
#   (events: checkout.session.completed, invoice.paid, customer.subscription.deleted), then paste its Signing secret:
STRIPE_WEBHOOK_SECRET=
LEMONSQUEEZY_WEBHOOK_SECRET=
DODO_WEBHOOK_SECRET=

# Optional email (password reset links + "trial ends in 3 days"). OFF while SMTP_HOST is empty. Never used for marketing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
