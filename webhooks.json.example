      "variants": {
        "123456": {
          "app": "reviewboost",
          "months": 1
        }
      }
    },
    "dodo": {
      "products": {
        "pdt_example123": {
          "app": "reviewboost",
          "months": 1
        }
      }
    }
  }
}
