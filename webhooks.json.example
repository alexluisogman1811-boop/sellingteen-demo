{
  "_help": "Put each payment product's ID next to the app it unlocks. months: 1 for monthly, 12 for yearly. See HOW-TO-PUT-ALL-APPS-ONLINE.md.",
  "accept_test_mode": false,
  "lemonsqueezy": {
    "variants": {},
    "products": {}
  },
  "dodo": {
    "products": {}
  },
